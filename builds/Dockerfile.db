# Jenmon Database Dockerfile
# Based on PostgreSQL 15.13 for stability
FROM postgres:15.13

# Set environment variables
ENV POSTGRES_DB=jenkins_dashboard
ENV POSTGRES_USER=jenkins_user

# Copy the database initialization script from the local repository
COPY db/init/01_init.sql /docker-entrypoint-initdb.d/init.sql

# Set proper permissions
RUN chmod 644 /docker-entrypoint-initdb.d/init.sql

# Add labels for better image management
LABEL maintainer="Jenmon Team"
LABEL description="Jenmon Database with Jenkins Dashboard Schema"
LABEL version="15.13-v1.0.0"

# Expose PostgreSQL port
EXPOSE 5432

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD pg_isready -U jenkins_user -d jenkins_dashboard || exit 1 